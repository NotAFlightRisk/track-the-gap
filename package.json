{
  "name": "track-the-gap",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build/index.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "network": "node scripts/build-network.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/hammersmith-one": "^5.3.0",
    "@sentry/browser": "^11.9.0",
    "@sentry/vite-plugin": "^11.8.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-vercel": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Live London Underground headways, service gaps and train bunching",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NotAFlightRisk/track-the-gap.git"
  },
  "homepage": "https://track-the-gap.peng.ly",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
